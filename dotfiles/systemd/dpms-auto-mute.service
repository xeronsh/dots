[Unit]
Description=Mute default audio sink while all connected displays are DPMS Off
PartOf=graphical-session.target
After=graphical-session.target wireplumber.service pipewire-pulse.service

[Service]
Type=simple
ExecStart=%h/.local/bin/dpms-auto-mute
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
