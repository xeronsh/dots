// === KISS Niri keymap ===
// Single source of truth for shortcuts. ~/.config/niri/config.kdl intentionally does NOT include dms/binds.kdl.
// Keep this file small, conflict-free, and close to your Hyprland muscle memory.

binds {
    // === Launchers / DMS ===
    Mod+D hotkey-overlay-title="Application Launcher" {
        spawn "dms" "ipc" "call" "spotlight" "toggle";
    }
    Mod+Space hotkey-overlay-title="Application Launcher" {
        spawn "dms" "ipc" "call" "spotlight" "toggle";
    }
    Mod+Tab repeat=false hotkey-overlay-title="Overview" { toggle-overview; }
    Mod+Shift+Slash hotkey-overlay-title="Hotkey Overlay" { show-hotkey-overlay; }

    Mod+V hotkey-overlay-title="Clipboard Manager" {
        spawn "dms" "ipc" "call" "clipboard" "toggle";
    }
    // Wayland ↔ X11 clipboard bridge for legacy X11 apps via xwayland-satellite.
    // WeChat itself now runs native Wayland and uses the normal clipboard.
    Mod+Alt+V hotkey-overlay-title="Clipboard: Wayland → X11 (legacy apps)" {
        spawn "sh" "-c" "wl-paste -n | env DISPLAY=:0 xsel -ib";
    }
    Mod+Alt+C hotkey-overlay-title="Clipboard: X11 → Wayland (legacy apps)" {
        spawn "sh" "-c" "env DISPLAY=:0 xsel -ob | wl-copy";
    }
    Mod+N hotkey-overlay-title="Notepad" {
        spawn "dms" "ipc" "call" "notepad" "toggle";
    }
    Mod+E hotkey-overlay-title="File Manager" {
        spawn "nautilus" "-w";
    }
    Mod+M hotkey-overlay-title="Task Manager" {
        spawn "dms" "ipc" "call" "processlist" "focusOrToggle";
    }
    Ctrl+Alt+Delete hotkey-overlay-title="Task Manager" {
        spawn "dms" "ipc" "call" "processlist" "focusOrToggle";
    }
    Mod+Comma hotkey-overlay-title="Settings" {
        spawn "dms" "ipc" "call" "settings" "focusOrToggle";
    }
    Mod+Y hotkey-overlay-title="Browse Wallpapers" {
        spawn "dms" "ipc" "call" "dankdash" "wallpaper";
    }
    Super+X hotkey-overlay-title="Power Menu" {
        spawn "dms" "ipc" "call" "powermenu" "toggle";
    }
    Mod+Shift+W hotkey-overlay-title="Window Rules" {
        spawn "dms" "ipc" "call" "window-rules" "toggle";
    }
    Mod+Shift+C hotkey-overlay-title="WeChat: Show/Raise" {
        spawn "sh" "-c" "exec $HOME/.local/bin/wechat-focus";
    }

    // === Terminal ===
    Mod+Return hotkey-overlay-title="Terminal" {
        spawn "kitty";
    }
    Alt+Return hotkey-overlay-title="Terminal" {
        spawn "kitty";
    }

    // === Screenshot / OCR ===
    Mod+P hotkey-overlay-title="Screenshot (satty)" {
        spawn "sh" "-c" "mkdir -p ~/Pictures/Screenshots && grim -g \"$(slurp)\" - | satty --filename - --early-exit --early-exit-save-as --copy-command wl-copy -o ~/Pictures/Screenshots/satty-%Y%m%d-%H%M%S.png";
    }
    Mod+O hotkey-overlay-title="OCR Translate (Pot)" {
        spawn "sh" "-c" "grim -g \"$(slurp)\" ~/.cache/com.pot-app.desktop/pot_screenshot_cut.png && curl \"127.0.0.1:60828/ocr_translate?screenshot=false\"";
    }
    Print { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print { screenshot-window; }

    // === Security / session ===
    Mod+L hotkey-overlay-title="Lock Screen" {
        spawn "dms" "ipc" "call" "lock" "lock";
    }
    Mod+Alt+L hotkey-overlay-title="Lock Screen" {
        spawn "dms" "ipc" "call" "lock" "lock";
    }
    Mod+Shift+E hotkey-overlay-title="Quit Niri" { quit; }
    Mod+Escape allow-inhibiting=false hotkey-overlay-title="Toggle Shortcut Inhibit" {
        toggle-keyboard-shortcuts-inhibit;
    }
    Mod+Shift+P hotkey-overlay-title="Power Off Monitors" { power-off-monitors; }

    // === Audio / media / brightness ===
    XF86AudioRaiseVolume allow-when-locked=true {
        spawn "dms" "ipc" "call" "audio" "increment" "3";
    }
    XF86AudioLowerVolume allow-when-locked=true {
        spawn "dms" "ipc" "call" "audio" "decrement" "3";
    }
    XF86AudioMute allow-when-locked=true {
        spawn "dms" "ipc" "call" "audio" "mute";
    }
    XF86AudioMicMute allow-when-locked=true {
        spawn "dms" "ipc" "call" "audio" "micmute";
    }
    XF86AudioPlay allow-when-locked=true {
        spawn "playerctl" "play-pause";
    }
    XF86AudioPause allow-when-locked=true {
        spawn "playerctl" "play-pause";
    }
    XF86AudioPrev allow-when-locked=true {
        spawn "playerctl" "previous";
    }
    XF86AudioNext allow-when-locked=true {
        spawn "playerctl" "next";
    }

    XF86MonBrightnessUp allow-when-locked=true {
        spawn "dms" "ipc" "call" "brightness" "increment" "5" "";
    }
    XF86MonBrightnessDown allow-when-locked=true {
        spawn "dms" "ipc" "call" "brightness" "decrement" "5" "";
    }

    // === Window management ===
    Mod+Q repeat=false hotkey-overlay-title="Close Window" { close-window; }
    // maximize-window-to-edges：贴到屏幕边缘、无 gap 无边框（视觉上等同全屏），
    // 但仍留在滚动平铺层，不会进入独立全屏层。
    Mod+F hotkey-overlay-title="Maximize to Edges" { maximize-window-to-edges; }
    Mod+Shift+F hotkey-overlay-title="Fullscreen Window" { fullscreen-window; }
    Mod+S hotkey-overlay-title="Toggle Floating" { toggle-window-floating; }
    Alt+N hotkey-overlay-title="Toggle Floating" { toggle-window-floating; }
    Mod+Shift+V hotkey-overlay-title="Focus Floating/Tiling" {
        switch-focus-between-floating-and-tiling;
    }
    Mod+G hotkey-overlay-title="Toggle Tabbed Column" { toggle-column-tabbed-display; }
    Mod+R hotkey-overlay-title="Preset Column Width (33/50/66/100%)" { switch-preset-column-width; }
    Mod+Ctrl+F hotkey-overlay-title="Expand Column to Available Width" { expand-column-to-available-width; }
    Mod+C hotkey-overlay-title="Center Column" { center-column; }
    Mod+Ctrl+C hotkey-overlay-title="Center Visible Columns" { center-visible-columns; }
    Mod+Period hotkey-overlay-title="Widen Column" { set-column-width "+10%"; }
    Mod+Slash hotkey-overlay-title="Narrow Column" { set-column-width "-10%"; }

    // === Focus / movement ===
    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up    { focus-window-up; }
    Mod+Down  { focus-window-down; }
    Mod+Semicolon  hotkey-overlay-title="Focus Column Left"  { focus-column-left; }
    Mod+Apostrophe hotkey-overlay-title="Focus Column Right" { focus-column-right; }

    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+Up    { move-window-up; }
    Mod+Shift+Down  { move-window-down; }
    Mod+Shift+Semicolon  hotkey-overlay-title="Move Column Left"  { move-column-left; }
    Mod+Shift+Apostrophe hotkey-overlay-title="Move Column Right" { move-column-right; }

    Mod+Home { focus-column-first; }
    Mod+End  { focus-column-last; }
    Mod+Ctrl+Home { move-column-to-first; }
    Mod+Ctrl+End  { move-column-to-last; }

    // === Workspaces ===
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }

    Alt+1 { move-column-to-workspace 1; }
    Alt+2 { move-column-to-workspace 2; }
    Alt+3 { move-column-to-workspace 3; }
    Alt+4 { move-column-to-workspace 4; }
    Alt+5 { move-column-to-workspace 5; }
    Alt+6 { move-column-to-workspace 6; }
    Alt+7 { move-column-to-workspace 7; }
    Alt+8 { move-column-to-workspace 8; }
    Alt+9 { move-column-to-workspace 9; }

    Mod+Page_Down { focus-workspace-down; }
    Mod+Page_Up   { focus-workspace-up; }
    Mod+Ctrl+Page_Down { move-column-to-workspace-down; }
    Mod+Ctrl+Page_Up   { move-column-to-workspace-up; }
}
